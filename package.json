{
  "name": "dongmianshan-next",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prepare-production.mjs && next build --webpack",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "articles:remap-categories": "node scripts/remap-article-categories.mjs",
    "local:setup": "node scripts/local-preview.mjs",
    "content:seed": "tsx scripts/seed-examples.ts",
    "check": "tsc --noEmit",
    "test:smoke": "node --env-file=.env.local --import tsx scripts/smoke-check.ts",
    "test:links": "node scripts/check-links.mjs",
    "prestart": "node scripts/prepare-production.mjs",
    "test:editability": "node --env-file=.env.local --import tsx scripts/editability-check.ts",
    "test:markdown": "tsx scripts/markdown-check.ts"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@prisma/client": "^6.18.0",
    "iron-session": "^8.0.4",
    "marked": "^18.0.2",
    "next": "16.3.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "2.17.5",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/sanitize-html": "^2.16.1",
    "prisma": "^6.18.0",
    "typescript": "5.8.3"
  }
}
