generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ArticleStatus {
  draft
  published
}

enum PublishStatus {
  draft
  published
}

model Article {
  id             String   @id @default(cuid())
  code           String?  @unique @db.VarChar(40)
  title          String   @db.VarChar(200)
  slug           String   @unique @db.VarChar(200)
  summary        String?  @db.Text
  content        String   @db.LongText
  coverImage     String?  @db.VarChar(2048)
  category       String   @db.VarChar(80)
  tags           String?  @db.Text
  seoTitle       String?  @db.VarChar(200)
  seoDescription String?  @db.Text
  relatedArticleIds Json?
  status         ArticleStatus @default(draft)
  author         String?  @db.VarChar(100)
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([code])
  @@index([status])
  @@index([deletedAt])
  @@index([updatedAt])
}

model Product {
  id             String        @id @default(cuid())
  name           String        @db.VarChar(200)
  slug           String        @unique @db.VarChar(200)
  subtitle       String?       @db.VarChar(200)
  summary        String?       @db.Text
  routineStep    String?       @db.VarChar(80)
  coverImage     String?       @db.VarChar(2048)
  shopUrl        String?       @db.VarChar(2048)
  benefits       Json?
  scenes         Json?
  seoTitle       String?       @db.VarChar(200)
  seoDescription String?       @db.Text
  status         PublishStatus @default(draft)
  sortOrder      Int           @default(0)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@index([deletedAt])
}

model SiteSection {
  id             String        @id @default(cuid())
  key            String        @unique @db.VarChar(80)
  title          String        @db.VarChar(200)
  eyebrow        String?       @db.VarChar(120)
  subtitle       String?       @db.Text
  body           String?       @db.Text
  mediaUrl       String?       @db.VarChar(2048)
  ctaLabel       String?       @db.VarChar(80)
  ctaUrl         String?       @db.VarChar(2048)
  items          Json?
  status         PublishStatus @default(draft)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([sortOrder])
}
